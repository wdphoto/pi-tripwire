{
  "name": "pi-tripwire",
  "version": "0.0.1",
  "description": "Pi extension that shows agent-spawned localhost servers in the footer.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "localhost",
    "footer"
  ],
  "pi": {
    "extensions": [
      "./extensions/tripwire/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test \"tripwire/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck && npm audit --omit=dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
