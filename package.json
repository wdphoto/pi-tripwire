{
  "name": "pi-tripwire",
  "version": "0.1.0",
  "description": "Pi extension that shows agent-spawned localhost servers in the footer.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "localhost",
    "footer"
  ],
  "pi": {
    "extensions": [
      "./extensions/tripwire/index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
